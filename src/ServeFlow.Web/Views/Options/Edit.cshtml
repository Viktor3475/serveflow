@model ServeFlow.Application.Management.OptionInput
@{ ViewData["Title"] = Model.Id is null ? "Add option" : "Edit option"; }
<div class="feature-card mx-auto dining-welcome"><h1 class="h2">@ViewData["Title"]</h1><form asp-action="Edit" asp-route-id="@Model.ItemId" method="post"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Id" type="hidden" /><input asp-for="ItemId" type="hidden" /><input asp-for="Version" type="hidden" /><div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" required maxlength="100" /></div><div class="mb-3"><label asp-for="Price" class="form-label">Additional price per item</label><input asp-for="Price" type="number" min="0" max="10000" step="0.01" class="form-control" required /></div><div class="form-check mb-3"><input asp-for="Available" class="form-check-input" /><label asp-for="Available" class="form-check-label"></label></div><div class="form-check mb-4"><input asp-for="Archived" class="form-check-input" /><label asp-for="Archived" class="form-check-label"></label></div><button class="btn btn-success" type="submit">Save option</button> <a asp-action="Index" asp-route-id="@Model.ItemId" class="btn btn-outline-secondary">Cancel</a></form></div>
