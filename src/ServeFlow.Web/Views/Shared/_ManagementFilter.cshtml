@model ServeFlow.Web.Models.PagingModel
<form method="get" asp-action="Index" class="d-flex flex-wrap gap-3 align-items-end mb-4">
    <div><label for="search" class="form-label">Search</label><input id="search" name="search" value="@Model.Search" maxlength="100" class="form-control" type="search" /></div>
    <div class="form-check mb-2"><input id="include-archived" type="checkbox" name="includeArchived" value="true" checked="@(Model.IncludeArchived ? "checked" : null)" class="form-check-input" /><label for="include-archived" class="form-check-label">Include archived</label></div>
    <button class="btn btn-outline-secondary" type="submit">Apply filters</button>
</form>
