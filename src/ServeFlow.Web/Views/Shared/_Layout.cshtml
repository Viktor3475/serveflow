@using ServeFlow.Application.Security
@{ var staff = User.Identity?.IsAuthenticated == true && StaffRoles.EmployeeRoles.Any(User.IsInRole); }
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" /><title>@ViewData["Title"] · ServeFlow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body class="@(staff ? "staff-workspace" : "guest-workspace")">
    <a href="#main-content" class="visually-hidden-focusable skip-link">Skip to content</a>
    @if (staff) { <partial name="_StaffSidebar" /><button id="sidebar-backdrop" class="sidebar-backdrop" type="button" aria-label="Close navigation" hidden></button> }
    <div class="workspace-main"><header class="app-header">
        @if (staff) { <div class="d-flex align-items-center gap-3"><button id="sidebar-toggle" class="btn btn-outline-secondary sidebar-toggle" type="button" aria-controls="staff-sidebar" aria-expanded="false" aria-label="Open navigation">☰</button><div><span class="workspace-breadcrumb">Restaurant workspace</span><div class="header-title">@ViewData["Title"]</div></div></div> }
        else { <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark" aria-hidden="true">S</span> ServeFlow</a> }
        <nav aria-label="Account navigation" class="account-navigation">
            <button id="theme-toggle" class="btn btn-outline-secondary btn-sm" type="button" aria-label="Switch to dark theme">Dark theme</button>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <details class="account-menu"><summary><span class="account-avatar" aria-hidden="true">@(User.FindFirst(StaffClaims.DisplayName)?.Value?.FirstOrDefault().ToString() ?? "S")</span><span class="account-name">@(User.FindFirst(StaffClaims.DisplayName)?.Value ?? "Your account")</span></summary><div class="account-menu-panel"><a asp-controller="Account" asp-action="ChangePassword">Change password</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-secondary btn-sm w-100" type="submit">Sign out</button></form></div></details>
            }
            else { <a asp-controller="Account" asp-action="Login" class="staff-signin">Staff sign in</a> }
        </nav>
    </header><main id="main-content" class="container-fluid workspace-content" tabindex="-1">
        @if (TempData["Success"] is string message) { <div class="alert alert-success" role="status">@message</div> }
        @RenderBody()
    </main><footer class="workspace-footer">ServeFlow <span aria-hidden="true">·</span> Made for the rhythm of service</footer></div>
</body></html>
