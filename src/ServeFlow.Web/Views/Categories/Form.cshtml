@model ServeFlow.Web.Models.CategoryModel
@{ var editing = Model.Id != Guid.Empty; ViewData["Title"] = editing ? "Edit category" : "Add category"; }
<div class="account-card mx-auto"><h1 class="h2 mb-4">@ViewData["Title"]</h1>
<form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : (Guid?)null)" method="post">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" />
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" required /></div>
    <div class="mb-4"><label asp-for="SortOrder" class="form-label"></label><input asp-for="SortOrder" class="form-control" min="0" max="10000" /></div>
    @if (editing) { <div class="form-check mb-4"><input asp-for="IsArchived" class="form-check-input" /><label asp-for="IsArchived" class="form-check-label"></label><div class="form-text">Archive or move active products before archiving this category.</div></div> }
    <button class="btn btn-success" type="submit">Save category</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form></div>
