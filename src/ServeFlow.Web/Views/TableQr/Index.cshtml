@model ServeFlow.Application.Management.TableDetails
@{ ViewData["Title"] = "Table QR code"; }
<div class="feature-card mx-auto dining-welcome"><span class="eyebrow">Table @Model.Number</span><h1 class="h2 mt-3">Generate a table QR code</h1><p>Download the SVG, print it, and place it at table @Model.Number. Every download creates a new code and revokes the previous code and its table sessions. Existing private order receipts remain readable.</p><p class="text-body-secondary">The raw QR link is available only in this download. Keep the printed code at its intended table.</p><form asp-action="Generate" asp-route-id="@Model.Id" method="post"><input type="hidden" name="version" value="@Model.Version" /><button class="btn btn-success" type="submit">Generate and download SVG</button> <a asp-controller="Tables" asp-action="Index" class="btn btn-outline-secondary">Back to tables</a></form></div>
