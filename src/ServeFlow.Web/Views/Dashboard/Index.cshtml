@model ServeFlow.Application.Analytics.DashboardData
@using System.Globalization
@using System.Text.Json
@{ ViewData["Title"] = "Overview"; }
@if (ViewData["AnalyticsError"] is string error)
{
    <div class="feature-card"><h1 class="h2">Choose another date range</h1><p class="text-danger" role="alert">@error</p><a asp-action="Index" class="btn btn-success mt-3">Return to this week</a></div>
}
else if (Model is not null)
{
    var zone = TimeZoneInfo.FindSystemTimeZoneById(Model.TimeZoneId);
    string Money(decimal value) => value.ToString("N2", CultureInfo.InvariantCulture) + " " + Model.CurrencyCode;
    string Local(DateTimeOffset value) => TimeZoneInfo.ConvertTime(value, zone).ToString("dd MMM, HH:mm", CultureInfo.InvariantCulture);
    var chartJson = JsonSerializer.Serialize(new { currency = Model.CurrencyCode, days = Model.Days.Select(x => new { date = x.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture), revenue = x.Revenue, orders = x.Orders }), popular = Model.Popular.Select(x => new { name = x.Name, units = x.Units }) });
    <div class="dashboard-welcome"><div><span class="eyebrow">The bigger picture</span><h1 class="h2">Your restaurant, at a glance.</h1><p>@Model.RestaurantName <span aria-hidden="true">·</span> <span>@Model.TimeZoneId</span></p></div><a asp-controller="Operations" asp-action="Index" class="btn btn-success">Open live orders <span aria-hidden="true">↗</span></a></div>
    <form method="get" asp-action="Index" class="dashboard-filters"><div><label for="from" class="form-label">From</label><input id="from" name="from" value="@Model.From.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" type="date" min="2000-01-01" max="2100-12-31" class="form-control" required /></div><div><label for="to" class="form-label">Through</label><input id="to" name="to" value="@Model.To.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" type="date" min="2000-01-01" max="2100-12-31" class="form-control" required /></div><button type="submit" class="btn btn-outline-success">Apply dates</button><a asp-action="Index" class="filter-reset">This week</a><span class="filter-context">Calendar dates in the restaurant’s time zone · up to 93 days</span></form>
    <div class="metric-grid">
        <article class="metric-card"><span class="metric-label">Collected in this range</span><strong>@Money(Model.Revenue)</strong><span class="metric-detail">Successful payments by payment date</span></article>
        <article class="metric-card"><span class="metric-label">Collected today</span><strong>@Money(Model.TodayRevenue)</strong><span class="metric-detail">Today in @Model.TimeZoneId</span></article>
        <article class="metric-card"><span class="metric-label">Orders placed</span><strong>@Model.OrderCount.ToString("N0")</strong><span class="metric-detail">Includes @Model.CancelledCount cancelled</span></article>
        <article class="metric-card"><span class="metric-label">Average order value</span><strong>@Money(Model.AverageOrderValue)</strong><span class="metric-detail">Excludes cancelled orders; includes unpaid orders</span></article>
    </div>
    <div class="dashboard-panels"><section class="feature-card chart-panel"><div class="panel-heading"><div><span class="eyebrow">Daily performance</span><h2 class="h5 mt-2">Collections &amp; orders</h2></div><span class="panel-meta">@Model.From.ToString("dd MMM") – @Model.To.ToString("dd MMM")</span></div><div class="chart-frame"><canvas id="revenue-chart" role="img" aria-label="Successful payment collections and order counts by date. The exact values are in the data table below."></canvas></div><details class="chart-data"><summary>View exact daily values</summary><div class="table-responsive"><table class="table table-sm"><caption>Collections use payment dates; orders use creation dates.</caption><thead><tr><th scope="col">Date</th><th scope="col">Collected</th><th scope="col">Orders</th></tr></thead><tbody>@foreach (var day in Model.Days) { <tr><th scope="row">@day.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</th><td>@Money(day.Revenue)</td><td>@day.Orders</td></tr> }</tbody></table></div></details></section>
    <section class="feature-card occupancy-panel"><span class="eyebrow">Right now</span><h2 class="h5 mt-2">Dining room</h2><div class="occupancy-value">@Model.Tables.Occupied<span>/ @Model.Tables.Total</span></div><p>Tables occupied <span class="occupancy-percent">@Model.Tables.Percent%</span></p><progress class="occupancy-progress" value="@Model.Tables.Occupied" max="@Math.Max(1, Model.Tables.Total)" aria-label="Occupied tables"></progress><dl class="occupancy-legend"><div><dt><span class="legend-dot available"></span>Available</dt><dd>@Model.Tables.Available</dd></div><div><dt><span class="legend-dot occupied"></span>Occupied</dt><dd>@Model.Tables.Occupied</dd></div><div><dt><span class="legend-dot reserved"></span>Reserved</dt><dd>@Model.Tables.Reserved</dd></div></dl><a asp-controller="Tables" asp-action="Index" class="btn btn-outline-secondary w-100">Manage tables</a><p class="form-text">Current active tables; independent of the date filter.</p></section></div>
    <div class="dashboard-bottom"><section class="feature-card"><div class="panel-heading"><div><span class="eyebrow">Guest favorites</span><h2 class="h5 mt-2">Most ordered products</h2></div><a asp-controller="Menu" asp-action="Index">Manage menu</a></div>@if (Model.Popular.Count == 0) { <div class="dashboard-empty">No non-cancelled products in this date range yet.</div> } else { <div class="popular-chart-frame"><canvas id="popular-chart" role="img" aria-label="Top products by quantity in non-cancelled orders. Exact values are listed below."></canvas></div><ol class="popular-list">@foreach (var item in Model.Popular) { <li><span>@item.Name</span><strong>@item.Units <span class="text-body-secondary fw-normal">units</span></strong></li> }</ol> }</section>
    <section class="feature-card recent-panel"><div class="panel-heading"><div><span class="eyebrow">Service history</span><h2 class="h5 mt-2">Recent orders</h2></div><a asp-controller="Operations" asp-action="Index">Live queue</a></div>@if (Model.Recent.Count == 0) { <div class="dashboard-empty">Your orders will appear here when service begins.</div> } else { <div class="table-responsive"><table class="table recent-orders"><caption>The latest 12 orders created in this range. Collected amounts include all successful payments for each order.</caption><thead><tr><th scope="col">Order</th><th scope="col">Status</th><th scope="col">Value</th><th scope="col">Collected</th></tr></thead><tbody>@foreach (var order in Model.Recent) { <tr><th scope="row"><span class="recent-number">@order.Number</span><span class="recent-time">Table @order.TableNumber · @Local(order.CreatedAt)</span></th><td><span class="badge order-status order-status-@((int)order.Status)">@order.Status</span></td><td>@Money(order.Total)</td><td>@Money(order.Collected)</td></tr> }</tbody></table></div> }</section></div>
    <p class="dashboard-footnote">Refreshed @Local(Model.RefreshedAt). Collections are recorded successful payments, not order totals. All amounts are in @Model.CurrencyCode.</p>
    <div id="dashboard-data" data-chart="@chartJson" hidden></div>
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true" defer></script><script src="~/js/dashboard.js" asp-append-version="true" defer></script>
}
