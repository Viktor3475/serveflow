# Documentation only. Copy outside the repository and replace EVERY placeholder.
# Production SQL: real application login with least privilege and trusted TLS.
ConnectionStrings__ServeFlow=Server=sql.example.com,1433;Database=ServeFlow;User ID=serveflow_app;Password=REPLACE_EXTERNALLY;Encrypt=true;TrustServerCertificate=false
ASPNETCORE_ENVIRONMENT=Production
AllowedHosts=orders.example.com
Ordering__PublicOrigin=https://orders.example.com
DataProtection__KeyPath=/data/keys
DataProtection__CertificatePath=/run/secrets/data-protection.pfx
DataProtection__CertificatePassword=REPLACE_EXTERNALLY
Uploads__RootPath=/data/images
# Only when running behind this exact trusted proxy; preserve the public Host.
ReverseProxy__KnownProxies__0=10.89.0.2
ASPNETCORE_HTTPS_PORT=443
